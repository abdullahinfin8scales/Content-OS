{
  "name": "infin8-content-os",
  "private": true,
  "version": "0.1.0",
  "description": "Infin8 Content OS: a private, local-first writing and archive space for social media content.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:cloud": "vite --port 5174 --strictPort --mode cloud",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:preview": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "@tiptap/extension-file-handler": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-typography": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.37.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
